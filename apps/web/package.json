{
  "name": "@wowsm/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm build:wasm && vite",
    "build": "pnpm build:wasm && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "build:wasm": "wasm-pack build ../../packages/ofx/crates/ofx-wasm --target web --out-dir pkg --release",
    "deploy": "pnpm build && wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply ofx --remote",
    "dev:api": "wrangler dev --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply ofx --local"
  },
  "dependencies": {
    "@wowsm/git": "workspace:*",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "better-auth": "1.7.2",
    "drizzle-orm": "0.45.2",
    "idb-keyval": "6.2.2",
    "jose": "^6.2.10",
    "just-bash": "3.4.2",
    "just-git": "1.8.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.1.1",
    "vite": "8.2.2",
    "wrangler": "^4.127.0"
  }
}
